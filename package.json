{
  "name": "huali-portal",
  "version": "1.0.0",
  "description": "Huali Portal desktop shell",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "start": "concurrently \"tsc -w\" \"electron .\"",
    "build": "tsc",
    "dist": "npm run build && electron-builder",
    "publish": "npm run build && electron-builder --publish always"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.1.0",
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.huali.portal",
    "productName": "HualiPortal",
    "directories": {
      "output": "dist-electron",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "kunkai2002",
      "repo": "huali-desktop-electron"
    }
  }
}
